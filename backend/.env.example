# QRUX Backend Environment Configuration
# Copy this to .env and update values

# Flask Configuration
FLASK_ENV=development
DEBUG=True
SECRET_KEY=your_secret_key_here

# In Cloud Run, provide the complete service-account JSON through Secret Manager.
# For local development, keep serviceAccountKey.json in this folder instead.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Configuration
FIREBASE_PROJECT_ID=qrux-11a39
FIREBASE_DATABASE_URL=https://qrux-11a39-default-rtdb.firebaseio.com
FIREBASE_STORAGE_BUCKET=qrux-11a39.appspot.com

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
BACKEND_URL=https://your-cloud-run-url
BACKEND_PORT=443

# QR Code Configuration
QR_CODE_SIZE=300  # pixels
QR_CODE_EXPIRY_DAYS=30  # Optional: days until QR code expires

# Optional: Sentry Error Tracking
SENTRY_DSN=

# Optional: Google Analytics
GA_TRACKING_ID=
